{
  "name": "default: agent-swarm code and traces",
  "description": "Pattern rules for code-like agent traces. Each rule says what the text would do; it is not proof that anything ran. Check precision on a labeled sample before relying on a rule.",
  "behaviors": [
    {
      "name": "network_request",
      "stage": "network",
      "flags": "i",
      "pattern": "fetch\\(|XMLHttpRequest|urllib\\.request|requests\\.(get|post)|socket\\.getaddrinfo",
      "description": "Makes a network request",
      "context": true
    },
    {
      "name": "http_post",
      "stage": "exfiltration",
      "pattern": "method:\\s*'POST'|\\.open\\('POST'|method='POST'|requests\\.post",
      "description": "Sends data with POST",
      "context": false
    },
    {
      "name": "remote_delete",
      "stage": "cover_up",
      "pattern": "method:\\s*'DELETE'|method='DELETE'|\\.delete\\(",
      "description": "Deletes something remotely",
      "context": false
    },
    {
      "name": "api_key_or_bearer",
      "stage": "credential_use",
      "pattern": "X-API-Key|Authorization['\"]?\\s*:\\s*'Bearer|Bearer '\\s*\\+",
      "description": "Attaches an API key or bearer token",
      "context": false
    },
    {
      "name": "image_beacon",
      "stage": "exfiltration",
      "pattern": "new Image|\\.src\\s*=\\s*'",
      "description": "Loads a URL as an image (silent request, often a beacon)",
      "context": false
    },
    {
      "name": "writes_to_page",
      "stage": "execution",
      "pattern": "innerHTML|innerText|document\\.write",
      "description": "Writes the result into the page",
      "context": true
    },
    {
      "name": "runs_shell",
      "stage": "execution",
      "pattern": "os\\.popen|subprocess|child_process|exec\\(",
      "description": "Runs shell commands",
      "context": false
    },
    {
      "name": "reads_system_files",
      "stage": "reconnaissance",
      "pattern": "/proc/|/etc/|resolv\\.conf|environ",
      "description": "Reads system, process, network or environment info",
      "context": false
    },
    {
      "name": "credential_search",
      "stage": "credential_access",
      "pattern": "serviceaccount|kube|clusterrole|/secrets|\\bsecrets\\b|auth\\.docker\\.io/token|LOOT|SECRET|PASSWORD",
      "description": "Looks for credentials or cluster access",
      "context": false
    },
    {
      "name": "repo_commit",
      "stage": "persistence",
      "pattern": "hfcommit|commit\\(|api/datasets/[^'\"]*/commit",
      "description": "Commits files to a repository",
      "context": false
    },
    {
      "name": "encodes_base64",
      "stage": "obfuscation",
      "pattern": "b64encode|base64|b32encode",
      "description": "Encodes data (base64)",
      "context": true
    },
    {
      "name": "identity_recon",
      "stage": "reconnaissance",
      "pattern": "\\bid;|uname -a|whoami",
      "description": "Runs identity or system-recon commands",
      "context": false
    },
    {
      "name": "timestamps",
      "stage": "tracking",
      "pattern": "Date\\.now\\(\\)|time\\.time\\(\\)",
      "description": "Uses timestamps (possibly to track runs)",
      "context": true
    },
    {
      "name": "mailbox_or_board_marker",
      "stage": "coordination",
      "pattern": "zz[A-Z0-9_]{3,}|MKCOL",
      "description": "Writes to a shared mailbox or board name",
      "context": false
    },
    {
      "name": "signed_command_channel",
      "stage": "coordination",
      "pattern": "signature|RSA|PKCS1|command channel|cmdfile|g23619cmd|OTS92CMD",
      "description": "Signed or polled command channel",
      "context": false
    },
    {
      "name": "self_replication_or_child_controller",
      "stage": "persistence",
      "pattern": "child controller|launch.*controller|pod.*create|create.*pod|pkill",
      "description": "Launches or replaces controllers or pods",
      "context": false
    },
    {
      "name": "captcha_or_waf",
      "stage": "evasion",
      "pattern": "aws-waf|challenge\\.js|captcha-response",
      "description": "Handles CAPTCHA or WAF challenges",
      "context": false
    },
    {
      "name": "cloud_metadata",
      "stage": "credential_access",
      "pattern": "169\\.254\\.169\\.254|IMDS",
      "description": "Queries cloud metadata",
      "context": false
    },
    {
      "name": "pastebin_or_search",
      "stage": "credential_access",
      "pattern": "pastebin|google\\.com/search|github\\.com/search",
      "description": "Searches public sites for credentials",
      "context": false
    },
    {
      "name": "registry_or_cache_poisoning",
      "stage": "supply_chain",
      "pattern": "artifactory|docker ?hub|manifests|forceDownloadIfNewer",
      "description": "Touches a package registry or cache",
      "context": false
    },
    {
      "name": "flag_or_ctf_target",
      "stage": "evaluation_gaming",
      "pattern": "flag\\{|catflag|CVE-\\d{4}-\\d+|arvo|cybergym",
      "description": "Refers to a challenge flag or known CVE",
      "context": false
    },
    {
      "name": "remote_script_or_shortener",
      "stage": "execution",
      "context": true,
      "pattern": "<script src|SHORTENER|shortener|document\\.write\\('<script",
      "description": "Loads code from a remote URL or a link-shortener chain"
    }
  ],
  "handles": [
    "C6E6E",
    "C5DF",
    "C23RO",
    "C64I",
    "C608",
    "C5L14",
    "C5GH",
    "C4E1",
    "C4R1",
    "OTS92",
    "G23619",
    "G236C3",
    "G236",
    "LIBR11",
    "Future9180",
    "SC4E1",
    "SC4",
    "H20E1",
    "A22B",
    "PX32",
    "U58E1",
    "U58",
    "MARB051",
    "BE90",
    "flb4",
    "hb58428env",
    "K64AUTO",
    "M47E1",
    "C5",
    "C6"
  ],
  "placeholder_pattern": "\\[[A-Z][A-Z0-9 _:\\-]*[^\\]]*\\]"
}